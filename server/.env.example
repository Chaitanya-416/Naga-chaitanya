PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Server-side Gemini API key (never expose to client)
GEMINI_API_KEY=

# Supabase Server-side (Service role key for administrative tasks / RLS bypass if needed, never client exposed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Audit signing secret for HMAC tamper evidence
AUDIT_SIGNING_SECRET=audit-hmac-secret-at-least-32-chars-long
