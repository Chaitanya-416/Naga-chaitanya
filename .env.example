# ==========================================
# ScopeSeal AI - Environment Variables Template
# ==========================================
# DO NOT put real production secrets in this file.
# Copy this file to .env (or server/.env and client/.env) and fill in the values.

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Gemini API (Server-side ONLY - never expose to client)
GEMINI_API_KEY=

# Supabase PostgreSQL & Auth (Server-side ONLY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key-never-share

# Cryptographic Audit Signature Secret
AUDIT_SIGNING_SECRET=generate-a-secure-random-secret-for-audit-hash-signing

# --- Frontend Configuration ---
# Safe for browser exposure (VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:5000/api/v1
